   <children>
      <ImageView fx:id="dayStep" fitHeight="638.0" fitWidth="946.0" pickOnBounds="true">
         <image>
            <Image url="@../../../images/Night.jpg" />
         </image>
      </ImageView>
      <Button fx:id="backBtn" layoutX="14.0" layoutY="542.0" mnemonicParsing="false" onMouseClicked="#backClicked" prefHeight="66.0" prefWidth="52.0" style="-fx-background-color: transparent;" />
      <Button fx:id="dayBtn" layoutX="259.0" layoutY="438.0" mnemonicParsing="false" onMouseClicked="#dayClicked" prefHeight="137.0" prefWidth="79.0" style="-fx-background-color: transparent;" />
      <Button fx:id="play4Btn" layoutX="213.0" layoutY="336.0" mnemonicParsing="false" onMouseClicked="#play4Clicked" prefHeight="42.0" prefWidth="98.0" style="-fx-background-color: transparent;" />
      <Button fx:id="play5Btn" layoutX="433.0" layoutY="332.0" mnemonicParsing="false" onMouseClicked="#play5Clicked" prefHeight="50.0" prefWidth="98.0" style="-fx-background-color: transparent;" />
      <Button fx:id="play6Btn" layoutX="646.0" layoutY="327.0" mnemonicParsing="false" onMouseClicked="#play6Clicked" prefHeight="50.0" prefWidth="92.0" style="-fx-background-color: transparent;" />
   </children>
</AnchorPane>
