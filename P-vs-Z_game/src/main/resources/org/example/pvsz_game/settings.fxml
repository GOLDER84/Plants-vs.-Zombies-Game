<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Slider?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="500.0" prefWidth="700.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.pvsz_game.SettingsController">
   <children>
      <ImageView fitHeight="500.0" fitWidth="700.0" pickOnBounds="true">
         <image>
            <Image url="@../../../images/Setting.png" />
         </image>
      </ImageView>
      <Slider fx:id="audioSlider" layoutX="360.0" layoutY="209.0" prefHeight="30.0" prefWidth="265.0" style="-fx-background-color: transparent; -fx-background-radius: 2px; -fx-background-insets: 0; -fx-pref-height: 4px; -fx-background-color: black; -fx-padding: 0.25em;" />
      <Button layoutX="63.0" layoutY="385.0" mnemonicParsing="false" onMouseClicked="#creditsBtn" prefHeight="36.0" prefWidth="228.0" style="-fx-background-color: transparent;" />
      <Button layoutX="407.0" layoutY="440.0" mnemonicParsing="false" onMouseClicked="#okBtn" prefHeight="36.0" prefWidth="228.0" style="-fx-background-color: transparent;" />
      <Button layoutX="63.0" layoutY="440.0" mnemonicParsing="false" onMouseClicked="#aboutBtn" prefHeight="36.0" prefWidth="228.0" style="-fx-background-color: transparent;" />
      <Button layoutX="407.0" layoutY="393.0" mnemonicParsing="false" onMouseClicked="#logoutBtn" prefHeight="36.0" prefWidth="228.0" style="-fx-background-color: transparent;" />
   </children>
</AnchorPane>
