<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="638.0" prefWidth="946.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.pvsz_game.StepsDayController">
   <children>
      <ImageView fx:id="dayStep" fitHeight="638.0" fitWidth="946.0" pickOnBounds="true">
         <image>
            <Image url="@../../../images/Day.jpg" />
         </image>
      </ImageView>
      <Button fx:id="backBtn" layoutX="14.0" layoutY="542.0" mnemonicParsing="false" onMouseClicked="#backClicked" prefHeight="66.0" prefWidth="52.0" style="-fx-background-color: transparent;" />
      <Button fx:id="nightBtn" layoutX="345.0" layoutY="417.0" mnemonicParsing="false" onMouseClicked="#nightClicked" prefHeight="104.0" prefWidth="79.0" style="-fx-background-color: transparent;" />
      <Button fx:id="play1Btn" layoutX="240.0" layoutY="328.0" mnemonicParsing="false" onMouseClicked="#play1Clicked" prefHeight="42.0" prefWidth="92.0" style="-fx-background-color: transparent;" />
      <Button fx:id="play3Btn" layoutX="646.0" layoutY="328.0" mnemonicParsing="false" onMouseClicked="#play3Clicked" prefHeight="50.0" prefWidth="92.0" style="-fx-background-color: transparent;" />
      <Button fx:id="play2Btn" layoutX="436.0" layoutY="332.0" mnemonicParsing="false" onMouseClicked="#play2Clicked" prefHeight="50.0" prefWidth="98.0" style="-fx-background-color: transparent;" />
   </children>
</AnchorPane>
